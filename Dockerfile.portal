FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-portal.txt /app/requirements-portal.txt
RUN pip install --no-cache-dir -r /app/requirements-portal.txt
COPY . /app
EXPOSE 8080
CMD ["sh", "-c", "uvicorn backend.portal_app:app --host 0.0.0.0 --port $PORT"]
